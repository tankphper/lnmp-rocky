[client]
port = 3306
socket = /var/lib/mysql/mysql.sock

[mysql]
no-auto-rehash

[mysqld]
port = 3306
socket = /var/lib/mysql/mysql.sock
# grant tables must be IP addresses
skip-name-resolve
skip-external-locking
# default time zone
default-time-zone = '+08:00'
# 资源限制
# From cat /proc/sys/net/ipv4/tcp_max_syn_backlog
back_log = 4096
max_connections = 1200
max_connect_errors = 1000
table_open_cache = 1024
max_allowed_packet = 16M
thread_stack = 192K
transaction_isolation = REPEATABLE-READ
explicit_defaults_for_timestamp = true
open_files_limit = 51200
# 内存缓冲区
binlog_cache_size = 10M
max_heap_table_size = 64M
tmp_table_size = 64M
read_buffer_size = 2M
read_rnd_buffer_size = 8M
sort_buffer_size = 32M
join_buffer_size = 64M
thread_cache_size = 128
# 文本索引与规范
ft_min_word_len = 4
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
# 错误日志（移入 mysqld 组，使用系统本地时间戳）
log-error = /www/logs/mysql/error.log
log_timestamps = SYSTEM
# 慢查询日志
slow_query_log = 1
slow_query_log_file = /www/logs/mysql/slow.log
long_query_time = 1
# 二进制日志 (Binlog)
log-bin = mysql-bin
binlog_format = row
server-id = 1
# every transaction refresh to disk
sync_binlog = 1
# bin log expire 7 day
binlog_expire_logs_seconds = 604800
# InnoDB 引擎优化
# innodb_buffer_pool_size
# + key_buffer_size
# + max_connections*(sort_buffer_size+read_buffer_size+binlog_cache_size)
# + max_connections*2MB
innodb_buffer_pool_size = 2G
# this option takes effect only when innodb_buffer_pool_size >= 1GB
innodb_buffer_pool_instances = 2
# max depends on the maximum file size of the operating system
innodb_data_file_path = ibdata1:50M:autoextend:max:1G
# 1 is transaction safe
innodb_flush_log_at_trx_commit = 1
innodb_log_buffer_size = 32M
# MySQL 8.0.30+ 推荐的全新 Redo Log 容量管理（替代了旧的 log_file_size）
innodb_redo_log_capacity = 3G
innodb_max_dirty_pages_pct = 90
innodb_lock_wait_timeout = 60
# 定时任务
event_scheduler = 1

[mysqldump]
quick
max_allowed_packet = 16M

[myisamchk]
key_buffer_size = 256M
sort_buffer_size = 256M
read_buffer = 8M
write_buffer = 8M
